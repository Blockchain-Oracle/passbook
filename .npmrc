# Makes `engines` binding for `npm install` and `npm ci`: a wrong-major shell fails the install
# naming the required range, rather than npm treating the field as advisory and installing anyway.
#
# That is ALL it does. It does NOT gate `npm test`, `npx vitest run`, `npm run lint` or any other
# script — those run on whatever `node` is first on PATH once node_modules exists. Nothing in the
# verification path observes the pin today; see deferred-work.md for the `lint:engines` shape that
# would close it.
engine-strict=true

# The manifest pins every dependency exactly, so keep `npm install <pkg>` from reintroducing a
# caret. Not cosmetic: a caret on vitest is what would swap the rolldown resolver underneath the
# suite on a routine install — the break spec-0-9 already had to repair once.
save-exact=true
