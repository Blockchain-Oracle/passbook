{
  "name": "strk20-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "build:web": "node scripts/build-web.mjs",
    "smoke:sdk": "node scripts/smoke-sdk-build.mjs",
    "verify:mainnet-guard": "node scripts/verify-mainnet-guard.mjs",
    "lint": "npm run lint:claims && npm run lint:topology && npm run lint:tokens",
    "lint:claims": "node scripts/lint-claims.mjs",
    "lint:topology": "node scripts/lint-topology.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "render:topology": "node scripts/render-topology.mjs",
    "render:tokens": "node scripts/render-design-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@starknet-io/types-js": "0.10.3",
    "@starkware-libs/starknet-privacy-sdk": "file:vendor/starkware-libs-starknet-privacy-sdk-0.14.3-rc.2.tgz",
    "starknet": "10.5.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
